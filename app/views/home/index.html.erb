<h1>Home#index</h1>
<%= @message %>

<!-- 7 Days -->
<% history_url = economy_history_stocks_path(from: 6.days.ago.to_date.iso8601, to: Date.current.iso8601) %>
<div
  data-controller="chart"
  data-chart-url-value="<%= history_url %>"
  data-chart-title-value="Economy History - Last 7 Days"
  data-chart-show-symbol-value="true"
>
  <!-- Chart Element Container -->
  <div data-chart-target="chart" style="width: 100%; height: 400px;"></div>

  <!-- Status Element -->
  <div data-chart-target="status">Loading...</div>
</div>

<!-- Year -->
<% history_url = economy_history_stocks_path(from: 364.days.ago.to_date.iso8601, to: Date.current.iso8601) %>
<div
  data-controller="chart"
  data-chart-url-value="<%= history_url %>"
  data-chart-title-value="Economy History - Last 1 Year"
>
  <!-- Chart Element Container -->
  <div data-chart-target="chart" style="width: 100%; height: 400px;"></div>

  <!-- Status Element -->
  <div data-chart-target="status">Loading...</div>
</div>