<h1>Home#index</h1>
<%= @message %>

<!-- 30 Days -->
<% history_url = economy_history_stocks_path(from: 29.days.ago.to_date.iso8601, to: Date.current.iso8601) %>
<div
  data-controller="chart"
  data-chart-url-value="<%= history_url %>"
  data-chart-title-value="Economy History - Last 30 Days"
>
  <!-- Chart Element Container -->
  <div data-chart-target="chart" style="width: 100%; height: 400px;"></div>

  <!-- Status Element -->
  <div data-chart-target="status">Loading...</div>
</div>

